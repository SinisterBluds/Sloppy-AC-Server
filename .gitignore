# ============================================================
# ACServer — full-distribution mode: Server-Plugin + AC-Test
# are tracked IN FULL (jars, worlds, plugin data, configs).
# Still excluded: AC-SoftFork/, References/, root *.txt
# ============================================================

# --- Scope exclusions (not part of the distribution) ---
/AC-SoftFork/
References/
/*.txt

# --- Pure build / editor noise (regenerates, never distributed) ---
target/
__pycache__/
*.py[cod]
.idea/
.vscode/
*.iml
.DS_Store
Thumbs.db
*~
*.tmp
*.bak
